{
  "version": "1.0.0",
  "reference_mode": "ordinary_oracle",
  "direction": "maximize",
  "formula": "sum(group.weight * passed_in_group / len(group.checks))",
  "range": [
    0,
    1
  ],
  "groups": {
    "generation": {
      "weight": 0.15,
      "checks": [
        "types_sync",
        "types_async",
        "security_signatures",
        "required_media_body",
        "native_regressions"
      ]
    },
    "delivery": {
      "weight": 0.25,
      "checks": [
        "records_sync",
        "records_async",
        "numbers_sync",
        "numbers_async",
        "network_sync",
        "network_async"
      ]
    },
    "ownership": {
      "weight": 0.25,
      "checks": [
        "early_sync",
        "early_async",
        "empty_sync",
        "empty_async",
        "malformed_sync",
        "malformed_async",
        "consumer_sync",
        "consumer_async",
        "network_early_sync",
        "network_early_async",
        "cancel_async"
      ]
    },
    "protocol": {
      "weight": 0.15,
      "checks": [
        "status_sync",
        "status_async",
        "media_sync",
        "media_async"
      ]
    },
    "requests": {
      "weight": 0.2,
      "checks": [
        "anonymous_sync",
        "anonymous_async",
        "json_body_sync",
        "json_body_async",
        "multipart_body_sync",
        "multipart_body_async",
        "optional_sync",
        "optional_async",
        "shared_sync",
        "shared_async"
      ]
    }
  },
  "performance_score": {
    "enabled": false,
    "anchors": null
  },
  "limits": {
    "compile_wall_sec": 90,
    "probe_wall_sec": 12,
    "native_wall_sec": 90,
    "cpu_sec": 90,
    "memory_bytes": 1610612736,
    "file_bytes": 8388608,
    "output_bytes": 1048576,
    "snapshot_bytes": 33554432,
    "snapshot_files": 2000,
    "candidate_uid": 21001,
    "candidate_gid": 21001,
    "server_gate_sec": 5
  },
  "oracle": {
    "record_values": [
      {
        "class": "Event",
        "value": {
          "seq": 1,
          "label": "café",
          "state": "ready"
        }
      },
      {
        "class": "Event",
        "value": {
          "seq": 2,
          "label": "last"
        }
      }
    ],
    "network_values": [
      {
        "class": "Event",
        "value": {
          "seq": 1,
          "label": "first"
        }
      },
      {
        "class": "Event",
        "value": {
          "seq": 2,
          "label": "second"
        }
      }
    ],
    "ordinary": {
      "class": "Event",
      "value": {
        "seq": 9,
        "label": "plain"
      }
    },
    "numbers": [
      {
        "class": "int",
        "value": 1
      },
      {
        "class": "int",
        "value": 2
      },
      {
        "class": "int",
        "value": 3
      }
    ],
    "token": "Bearer token",
    "injected_token": "Injected hidden",
    "json_body": {
      "query": "find café"
    },
    "multipart_fields": [
      [
        "label",
        "upload"
      ],
      [
        "files",
        "alpha"
      ],
      [
        "files",
        "beta"
      ]
    ],
    "multipart_filenames": [
      "a.txt",
      "b.txt"
    ],
    "malformed_error": "JSONDecodeError",
    "consumer_error": "LookupError",
    "media_error": "ValueError",
    "status_error": "UnexpectedStatus",
    "status_code": 409
  },
  "native_tests": [
    "tests/test_parser/test_responses.py",
    "tests/test_parser/test_openapi.py"
  ],
  "split": {
    "public": [
      "stream-contract schema",
      "worker exerciser",
      "public smoke command"
    ],
    "feedback": "all named semantic groups, root-owned oracle assertions",
    "author_audit": [
      "near misses",
      "permission probe",
      "same snapshot repeats",
      "invalid submission and infrastructure fault controls"
    ]
  },
  "scoring_policy": {
    "candidate_failure": "valid true; affected checks fail",
    "infrastructure_failure": "valid false; score null; remove reward.txt and reward.json; exit nonzero"
  }
}
