[
  {
    "id": "ascii-escapes",
    "group": "decode",
    "request": {
      "op": "roundtrip",
      "text": "s=\"\\b\\e\\f\\n\\r\\t\\\\\\\"\"\n"
    },
    "expected": {
      "ok": true,
      "original": {
        "s": "\b\u001b\f\n\r\t\\\""
      },
      "text": "s=\"\\b\\e\\f\\n\\r\\t\\\\\\\"\"\n",
      "value": {
        "s": "\b\u001b\f\n\r\t\\\""
      }
    },
    "independent_check": "TOML 1.1 source reference only"
  },
  {
    "id": "unicode-widths",
    "group": "decode",
    "request": {
      "op": "roundtrip",
      "text": "s=\"\\x41\\u03B1\\U0001F600\"\n"
    },
    "expected": {
      "ok": true,
      "original": {
        "s": "Aα😀"
      },
      "text": "s=\"\\x41\\u03B1\\U0001F600\"\n",
      "value": {
        "s": "Aα😀"
      }
    },
    "independent_check": "TOML 1.1 source reference only"
  },
  {
