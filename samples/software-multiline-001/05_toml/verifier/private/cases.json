  {
    "id": "edit-root",
    "group": "edit",
    "request": {
      "op": "edit",
      "text": "a = 'unchanged' # comment\nb = 2\n",
      "changes": [
        {
          "path": [
            "b"
          ],
          "value": "line\n\"quote\"\\tail"
        }
      ]
    },
    "expected": {
      "ok": true,
      "original": {
        "a": "unchanged",
        "b": 2
      },
      "text": "a = 'unchanged' # comment\nb = '''\nline\n\"quote\"\\tail'''\n",
      "value": {
        "a": "unchanged",
        "b": "line\n\"quote\"\\tail"
      }
    },
    "independent_check": "Python 3.12 tomllib semantic equality"
  },
  {
    "id": "edit-nested",
    "group": "edit",
    "request": {
      "op": "edit",
      "text": "# banner\n[package]\nname='old'\nversion = '1.0' # keep\n",
      "changes": [
        {
          "path": [
            "package",
            "name"
          ],
          "value": "new\nname"
        }
      ]
    },
    "expected": {
      "ok": true,
      "original": {
        "package": {
          "name": "old",
          "version": "1.0"
        }
      },
      "text": "# banner\n[package]\nname= \"\"\"\nnew\nname\"\"\"\nversion = '1.0' # keep\n",
      "value": {
        "package": {
          "name": "new\nname",
          "version": "1.0"
        }
      }
    },
    "independent_check": "Python 3.12 tomllib semantic equality"
  },
  {
    "id": "edit-array",
    "group": "edit",
    "request": {
      "op": "edit",
      "text": "items = [\"old\", 'keep', \"last\"] # tail\n",
