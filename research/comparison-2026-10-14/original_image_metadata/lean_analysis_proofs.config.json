    {
      "created": "2026-07-02T19:17:59.539653721+08:00",
      "created_by": "/bin/sh -c set -e; rm -f /tmp/fix_lake_git.py /tmp/setup_workspace.sh /tmp/setup_judge.sh; \nexport GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0=\"*\"\nfor g in $(find /home/workspace /home/*_agent /app -maxdepth 3 -name .git -type d 2>/dev/null | grep -v \"/\\.lake/\"); do\n  d=$(dirname \"$g\")\n  dirty=$(git -C \"$d\" status --porcelain 2>/dev/null | head -1)\n  [ -z \"$dirty\" ] && continue\n  before=$(git -C \"$d\" ls-files | wc -l)\n  own=$(stat -c %u:%g \"$d\")\n  cd \"$d\"\n  rm -rf .git\n  git init -q\n  git symbolic-ref HEAD refs/heads/master\n  git config user.email \"sebench@local\"\n  git config user.name \"sebench\"\n  git add -A\n  git commit -q -m init\n  after=$(git ls-files | wc -l)\n  # sanity: tracked count must not explode (e.g. .lake accidentally added)\n  if [ \"$after\" -gt $((before * 2 + 50)) ]; then echo \"TRACKED_EXPLODED $d $before->$after\"; exit 9; fi\n  chown -R \"$own\" .git\n  echo \"REINIT $d tracked $before->$after\"\n  cd /\ndone\n"
    }
